/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { version 2.0; format ascii; class volVectorField; location "0/fluid"; object U; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);    // quiescent bath at t = 0

boundaryField
{
    "symmetry.*"
    {
        type            symmetryPlane;
    }

    "bath.*"
    {
        type            noSlip;
    }

    fluid_to_battery
    {
        type            noSlip;
    }

    // Expansion port: zero gradient for outflow; for inflow the tangential component is
    // set to zero and the normal one is taken from the cell (pressureInletOutletVelocity .cxx:167).
    expansionPort
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
}

